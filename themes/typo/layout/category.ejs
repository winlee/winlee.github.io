<%
var catName = page.category || page.title;
var posts = site.posts.filter(function (post) {
  if (!post.categories) return false;
  return post.categories.toArray().some(function (cat) { return cat.name === catName; });
});
%>
<div class="post-list">
  <div class="category-title">分类：<%= catName %></div>
  <% posts.sort('-date').each(function (post) { %>
  <section class="post-item">
    <a class="post-item-title" href="<%- url_for(post.path) %>"><%= post.title %></a>
    <div class="post-item-summary">
      <%- strip_html(post.excerpt || post.content).substr(0, 240) %>
      <a class="read-more" href="<%- url_for(post.path) %>"> ... </a>
    </div>
    <div class="post-item-extra">
      <div class="date"><%- date(post.date, "YYYY.MM.DD") %></div>
      <div class="tags">
        <% post.tags.map(tag => tag.name).forEach(function (tag) { %>
        <div class="tag-item"><%- tag %></div>
        <% }) %>
      </div>
    </div>
  </section>
  <% }); %>
  <% if (!posts.length) { %>
  <p class="category-empty">暂无文章</p>
  <% } %>
</div>
