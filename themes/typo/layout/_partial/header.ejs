<header class="header">
  <section class="header-container">
    <a class="logo" href="<%- url_for() %>"><%= config.title %></a>
    <ul class="nav">
      <% if (theme.categories_menu && theme.categories_menu.length) { %>
      <li class="nav-dropdown">
        <details>
          <summary class="nav-dropdown-toggle">分类</summary>
        <ul class="nav-dropdown-menu">
          <% theme.categories_menu.forEach(function (cat) { %>
          <li><a href="<%- url_for('/categories/' + cat + '/') %>"><%= cat %></a></li>
          <% }); %>
        </ul>
        </details>
      </li>
      <% } %>
      <% for (name in theme.menu) { %>
      <li><a href="<%- url_for(theme.menu[name]) %>"><%= name.charAt(0).toUpperCase() + name.slice(1) %></a></li>
      <% } %>
    </ul>
  </section>
</header>